# Copy to api/.env and fill in. Never commit the filled version.

# Reasoning model. groq | gemini | anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Fallback provider, used when groq rate limits
GOOGLE_API_KEY=

DATABASE_URL=postgresql+psycopg://screenr:screenr@localhost:5432/screenr

# Only needed once audio is wired up
DEEPGRAM_API_KEY=

# v1 has one recruiter account, see docs/adr/004-no-auth-provider.md
RECRUITER_EMAIL=you@example.com
RECRUITER_PASSWORD=
JWT_SECRET=

MAX_INTERVIEW_SECONDS=1200
MAX_TURNS=60
MAX_PROBES_PER_TOPIC=2

CORS_ORIGINS=http://localhost:3000
