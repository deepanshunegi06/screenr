# Copy to api/.env and fill in. Never commit the filled version.

# Reasoning model for evals and the terminal interviewer. Voice interviews do
# not use this -- Deepgram runs their own model, see VOICE_THINK_* below.
# groq | openai | gemini | anthropic
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# OpenAI. Set LLM_PROVIDER=openai and LLM_MODEL=gpt-5-mini to use it.
# Groq's free tier caps at 200k tokens a day, which one eval sweep can spend.
OPENAI_API_KEY=

# Google AI Studio. Free, no card, and the most generous daily quota of the
# providers this supports -- get one at https://aistudio.google.com/apikey then
# set LLM_PROVIDER=gemini and LLM_MODEL=gemini-2.5-flash.
GOOGLE_API_KEY=

# where the sqlite file lives
DATA_DIR=data

# Only needed once audio is wired up
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
# Model deepgram runs for voice. anthropic|open_ai|google
VOICE_THINK_PROVIDER=anthropic
VOICE_THINK_MODEL=claude-sonnet-5

# Emailing invites, tried in this order.
#
# Brevo first: an HTTPS API (so a host that blocks SMTP cannot stop it) that
# verifies one sender address with an emailed code instead of DNS records, so it
# reaches real candidates without owning a domain. 300/day free.
BREVO_API_KEY=
# Resend last: it refuses every recipient except the account owner until a
# domain is verified at resend.com/domains.
RESEND_API_KEY=
MAIL_FROM=screenr <onboarding@resend.dev>

# Or plain SMTP, which needs no domain: set SMTP_USER and invites go out through
# it instead of Resend. For Gmail, SMTP_PASSWORD is an app password from
# myaccount.google.com/apppasswords, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The origin an invite link points at, e.g. https://screenr.example.com
WEB_ORIGIN=http://localhost:3000

# v1 has one recruiter account, see docs/adr/004-no-auth-provider.md
RECRUITER_EMAIL=you@example.com
RECRUITER_PASSWORD=
JWT_SECRET=
# exposes a one-click demo sign-in; off by default
DEMO_MODE=false

MAX_INTERVIEW_SECONDS=1200
MAX_TURNS=60
MAX_PROBES_PER_TOPIC=2

CORS_ORIGINS=http://localhost:3000
